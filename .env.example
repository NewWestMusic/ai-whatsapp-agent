# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Any long random string. Paste the same value into the Landbot Webhook block's
# "x-webhook-secret" header. Generate one with:  openssl rand -hex 24
WEBHOOK_SECRET=change-me

PORT=3000
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# KNOWLEDGE_FILE=./knowledge.md

# Conversation memory. Required on Vercel (otherwise memory is lost between
# messages). Adding Upstash Redis from the Vercel Marketplace sets these for you:
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...
