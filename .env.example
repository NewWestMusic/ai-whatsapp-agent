# Claude. Get a key at https://console.anthropic.com (separate from a claude.ai plan)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta app). See README "Meta app and WhatsApp number".
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the same value into the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=

# Airtable personal access token with data.records:read/write on the
# "Facebook Lead Forms Tracker" base. Leads go to its "WhatsApp Leads" table.
AIRTABLE_TOKEN=

# Conversation memory. Adding Upstash Redis in Vercel sets these for you.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...

PORT=3000

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# WEBHOOK_SECRET=...            # only if you use the Landbot endpoint
# AIRTABLE_BASE_ID=appMB0fLLfFzT0Ult
# AIRTABLE_LEADS_TABLE_ID=tblAmIvm7gPQEr3sM
# WHATSAPP_GRAPH_VERSION=v23.0
